{
  "name": "@iot-nexus/simulator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup src/index.ts --format esm --sourcemap --clean --external @iot-nexus/shared",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@iot-nexus/shared": "workspace:*",
    "mqtt": "^5.14.1",
    "pino": "^10.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@iot-nexus/config": "workspace:*",
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  }
}
