NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
FIREBASE_PROJECT_ID=demo-iot-nexus
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Future adapters only; no MQTT/Firebase connections are started in Phase 0.
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_ALLOW_INSECURE_LOCAL=true
TELEMETRY_MAX_AGE_SECONDS=120
TELEMETRY_MAX_FUTURE_SKEW_SECONDS=30
LATEST_WRITE_INTERVAL_MS=5000
HISTORY_SAMPLE_INTERVAL_MS=60000
# Production only: prefer workload identity / Application Default Credentials.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repository/service-account.json
# MQTT_USERNAME=
# MQTT_PASSWORD=
